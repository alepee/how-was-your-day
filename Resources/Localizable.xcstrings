    "%@ est exclue de la reconnaissance. Levez l’exclusion dans Réglages › Audio et voix.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is excluded from recognition. Allow recognition in Settings › Audio & Voice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est exclue de la reconnaissance. Levez l’exclusion dans Réglages › Audio et voix."
          }
        }
      }
    },
    "%@ expose %u canaux dans le graphe audio, %u attendus. Aucun enregistrement n’a démarré.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ exposes %2$u channels in the audio graph, %3$u expected. No recording started."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expose %u canaux dans le graphe audio, %u attendus. Aucun enregistrement n’a démarré."
          }
        }
      }
    },
    "%@ expose %u canaux, au-delà des 16 canaux pris en charge. Aucun enregistrement n’a démarré.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ exposes %2$u channels, more than the 16 supported. No recording started."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expose %u canaux, au-delà des 16 canaux pris en charge. Aucun enregistrement n’a démarré."
          }
        }
      }
    },
    "%@ expose %u canaux, entre 1 et 16 pris en charge. Aucun enregistrement n’a démarré.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ exposes %2$u channels, between 1 and 16 supported. No recording started."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expose %u canaux, entre 1 et 16 pris en charge. Aucun enregistrement n’a démarré."
          }
        }
      }
    },
    "%@ fournit un format non pris en charge (%@, %u bits), PCM flottant 32 bits attendu. Aucun enregistrement n’a démarré.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ provides an unsupported format (%2$@, %3$u bits), 32-bit float PCM expected. No recording started."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fournit un format non pris en charge (%@, %u bits), PCM flottant 32 bits attendu. Aucun enregistrement n’a démarré."
          }
        }
      }
    },
    "%@ ignorée : ses passages sont masqués du transcript, de l’export et de la synthèse.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ignored: its passages are hidden from the transcript, the export and the summary."
