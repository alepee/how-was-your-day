          }
        }
      }
    },
    "Le serveur local garde le transcript sur ce Mac. Un agent ACP (Claude Code, Codex…) rédige avec votre propre contexte. Avec Mistral, OpenAI, Anthropic ou Google Gemini, le transcript est envoyé au fournisseur à chaque synthèse, une fois sa clé API enregistrée.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local server keeps the transcript on this Mac. An ACP agent (Claude Code, Codex…) writes with your own context. With Mistral, OpenAI, Anthropic or Google Gemini, the transcript is sent to the provider for each summary, once its API key is saved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur local garde le transcript sur ce Mac. Un agent ACP (Claude Code, Codex…) rédige avec votre propre contexte. Avec Mistral, OpenAI, Anthropic ou Google Gemini, le transcript est envoyé au fournisseur à chaque synthèse, une fois sa clé API enregistrée."
          }
        }
      }
    },
    "Le store local n’est pas disponible.": {
      "localizations": {
