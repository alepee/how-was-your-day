    "%@ a refusé de produire cette synthèse. Aucun résultat n’a été enregistré.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ declined to produce this summary. No result was saved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé de produire cette synthèse. Aucun résultat n’a été enregistré."
          }
        }
      }
    },
    "%@ a refusé la clé API (HTTP %lld). %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rejected the API key (HTTP %2$lld). %3$@"
