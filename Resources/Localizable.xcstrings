    "La synthèse contient des copies de passages ou des références internes. Elle n’a pas été enregistrée. Essayez un autre modèle.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The summary contains copied passages or internal references. It was not saved. Try another model."
