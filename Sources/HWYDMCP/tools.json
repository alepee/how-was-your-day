{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Person": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "alias": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "named",
            "unnamed"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "alias",
        "status"
      ],
      "additionalProperties": false
    },
    "RecordingMetadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "meeting",
            "call",
            "conversation",
            "voice-memo",
            "ad-hoc"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_us": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "capturing",
            "processing",
            "complete",
            "partial",
            "failed"
          ]
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Person"
          }
        },
        "echo_cancellation_engine": {
          "type": [
            "string",
            "null"
          ]
        },
        "echo_assessed_segments": {
          "type": "integer",
          "minimum": 0
        },
        "echo_suspect_segments": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "revision",
        "title",
        "kind",
        "started_at",
        "duration_us",
        "status",
        "participants",
        "echo_cancellation_engine",
        "echo_assessed_segments",
        "echo_suspect_segments"
      ],
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "pending",
            "disabled",
            "failed",
            "stale",
            "unavailable"
          ]
        },
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "markdown": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "version",
        "markdown",
        "reason"
      ],
      "additionalProperties": false
    },
    "MutationReceipt": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "export_state": {
          "type": "string",
          "enum": [
            "published",
            "pending"
          ]
        },
        "identity_enrollment": {
          "const": "not_performed"
        }
      },
      "required": [
        "request_id",
        "id",
        "revision",
        "export_state",
        "identity_enrollment"
      ],
      "additionalProperties": false
    },
    "TranscriptSegment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "track": {
          "type": "string",
          "enum": [
            "mic",
            "system"
          ]
        },
        "speaker_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "speaker_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "person_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "speaker_confirmed": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "echo_suspect": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "text_offset": {
          "type": "integer",
          "minimum": 0
        },
        "text_total_chars": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "track",
        "speaker_id",
        "speaker_name",
        "person_id",
        "speaker_confirmed",
        "text",
        "confidence",
        "echo_suspect",
        "text_offset",
        "text_total_chars",
        "partial"
      ]
    }
  },
  "tools": {
    "list_recordings": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string",
            "enum": [
              "meeting",
              "call",
              "conversation",
              "voice-memo",
              "ad-hoc"
            ]
          },
          "participant": {
            "type": "string",
            "format": "uuid"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/RecordingMetadata"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot_seq": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "next_cursor",
          "snapshot_seq"
        ],
        "additionalProperties": false
      },
      "description": "List stored recordings, newest first, with confirmed participants deduplicated by person ID. No implicit date filter. limit is a maximum, not a required result count. Follow next_cursor with identical arguments until null; cursors expire after 15 minutes or a store change."
    },
    "get_recording": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "include": {
            "type": "string",
            "enum": [
              "transcript",
              "summary",
              "notes",
              "all"
            ],
            "default": "all"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "cursor": {
            "type": "string"
          },
          "max_chars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 100000,
            "default": 30000
          },
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "structured"
            ],
            "default": "markdown"
          },
          "max_segments": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          },
          "from": {
            "type": "number",
            "minimum": 0
          },
          "to": {
            "type": "number",
            "minimum": 0
          },
          "track": {
            "type": "string",
            "enum": [
              "mic",
              "system"
            ]
          },
          "speaker": {
            "type": "string",
            "format": "uuid"
          },
          "exclude_unattributed": {
            "type": "boolean",
            "default": false
          },
          "exclude_echo_suspect": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "recording": {
            "$ref": "#/$defs/RecordingMetadata"
          },
          "artifacts": {
            "type": "object",
            "properties": {
              "transcript": {
                "$ref": "#/$defs/Artifact"
              },
              "summary": {
                "$ref": "#/$defs/Artifact"
              },
              "notes": {
                "$ref": "#/$defs/Artifact"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/TranscriptSegment"
            }
          },
          "total_chars": {
            "type": "integer",
            "minimum": 0
          },
          "total_segments": {
            "type": "integer",
            "minimum": 0
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "page_chars": {
            "type": "integer",
            "minimum": 0
          },
          "partial_segment": {
            "type": "boolean"
          }
        },
        "required": [
          "recording",
          "artifacts",
          "next_cursor",
          "truncated",
          "total_chars",
          "total_segments",
          "total_pages",
          "page",
          "page_chars",
          "partial_segment"
        ],
        "additionalProperties": false
      },
      "description": "Read a recording in bounded pages. Default max_chars=30000 and max_segments=100. Follow next_cursor with identical arguments until null. Transcript pages preserve whole segments except explicitly marked oversized fragments. format=structured returns timed segments; track mic is microphone, system is audio from other apps. Time filters use seconds and select overlapping segments. speaker filters acoustic speaker_id, not person_id. Unknown confidence/echo status is null. Unavailable summaries include a reason; this tool does not generate them. Page totals cover selected artifacts/filters. Resource templates return unpaginated Markdown. echo_cancellation_engine records audio preprocessing, not proof of echo-free text; echo_assessed_segments and echo_suspect_segments count post-transcription assessment."
    },
    "search": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "kind": {
            "type": "string",
            "enum": [
              "meeting",
              "call",
              "conversation",
              "voice-memo",
              "ad-hoc"
            ]
          },
          "participant": {
            "type": "string",
            "format": "uuid"
          },
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "recording_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "artifact": {
                  "type": "string",
                  "enum": [
                    "title",
                    "transcript",
                    "summary",
                    "notes"
                  ]
                },
                "entity_id": {
                  "type": "string"
                },
                "snippet": {
                  "type": "string"
                },
                "rank": {
                  "type": "number"
                },
                "resource_uri": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "recording_id",
                "revision",
                "artifact",
                "entity_id",
                "snippet",
                "rank",
                "resource_uri"
              ],
              "additionalProperties": false
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot_seq": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "next_cursor",
          "snapshot_seq"
        ],
        "additionalProperties": false
      },
      "description": "Search stored titles, transcripts, notes and summaries with SQLite FTS. Optional since/kind/participant filters. Follow next_cursor with identical arguments; returned snippets are excerpts, not full transcripts."
    },
    "get_participants": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Person"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "snapshot_seq": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "next_cursor",
          "snapshot_seq"
        ],
        "additionalProperties": false
      },
      "description": "List known people from the local identity directory, not individual acoustic voice clusters. Paginated with limit and next_cursor."
    },
    "set_notes": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "markdown": {
            "type": "string",
            "maxLength": 200000
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "markdown",
          "expected_revision",
          "request_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/MutationReceipt"
      },
      "description": "Replace manual notes using expected_revision and a unique request_id for safe retries. Requires --allow-write and the app write setting. Does not modify transcript or summary."
    },
    "rename_speaker": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "person": {
            "type": "string",
            "format": "uuid"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "speaker",
          "person",
          "expected_revision",
          "request_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/MutationReceipt"
      },
      "description": "Link an acoustic speaker cluster to an existing person using expected_revision and a unique request_id. Requires --allow-write and the app write setting. Does not enroll voice fingerprints."
    }
  }
}
